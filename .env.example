# Setelan laptop developer. Salin ke .env (cp .env.example .env), lalu isi APP_KEY:
#   bun -e "console.log('base64:' + Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
# Database sama dengan perintah docker run di AGENTS.md (bagian test lokal). Nilai di sini hanya untuk laptop.

DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=operations_dev
DB_USERNAME=ci
DB_PASSWORD=ci-only-not-a-secret

# Setiap database lingkungan mendapat pool sebesar ini, ditambah satu pool untuk database runtime. dev:setup membuat
# dua lingkungan, jadi paling banyak 3 x 3 = 9 koneksi. Ukuran untuk server menunggu uji beban (lihat AGENTS.md).
DB_POOL_SIZE=3

APP_KEY=

# Lingkungan dibuka di <tenant>.localhost:8000 dan <tenant>.demo.localhost:8000.
BASE_DOMAIN=localhost
