{
    "name": "operations-metta",
    "private": true,
    "type": "module",
    "workspaces": [
        "modules/*",
        "packages/*"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui",
        "test": "bun test",
        "new-feature": "bun scripts/new-feature.ts",
        "build": "bun build src/main.ts --target=bun --outdir dist --minify",
        "start": "bun src/main.ts",
        "format": "prettier --write src modules packages scripts test .github package.json tsconfig.json",
        "format:check": "prettier --check src modules packages scripts test .github package.json tsconfig.json",
        "check:boundaries": "bun scripts/check-boundaries.ts",
        "migrate": "bun scripts/migrate.ts"
    },
    "dependencies": {
        "@operations-metta/ui": "workspace:*",
        "@orpc/openapi": "1.16.1",
        "@orpc/server": "1.16.1",
        "@sentry/bun": "11.9.0",
        "elysia": "1.4.30",
        "postgres": "3.4.7",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "prettier": "3.9.5",
        "prettier-plugin-tailwindcss": "0.6.14",
        "tailwindcss": "4.3.2",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3"
    }
}
