{
    "name": "operations-metta",
    "private": true,
    "type": "module",
    "workspaces": [
        "modules/*"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "build": "bun build src/main.ts --target=bun --outdir dist --minify",
        "start": "bun src/main.ts",
        "format": "prettier --write src test modules scripts .github package.json tsconfig.json",
        "format:check": "prettier --check src test modules scripts .github package.json tsconfig.json",
        "check:boundaries": "bun scripts/check-boundaries.ts",
        "migrate": "bun scripts/migrate.ts"
    },
    "dependencies": {
        "@orpc/openapi": "1.16.1",
        "@orpc/server": "1.16.1",
        "elysia": "1.4.30",
        "postgres": "3.4.7",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "prettier": "3.9.5",
        "prettier-plugin-tailwindcss": "0.6.14",
        "tailwindcss": "4.3.2",
        "typescript": "5.9.3"
    }
}
