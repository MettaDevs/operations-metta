{
    "compilerOptions": {
        "target": "ES2024",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["bun"],
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noFallthroughCasesInSwitch": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "paths": {
            "@core/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "modules/*/src/**/*.ts",
        "modules/*/src/**/*.tsx",
        "modules/*/test/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts"
    ]
}
